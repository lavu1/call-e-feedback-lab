# Server-only credential from the CALL-E dashboard. Never commit the real value.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Use only a phone number owned by, or explicitly authorized by, the test recipient.
CALLE_TEST_PHONE=
CALLE_TEST_REGION=
CALLE_TEST_LOCALE=en-US

# Record consent outside this repository, then set these values for one authorized test.
CALLE_CONSENT_CONFIRMED=no
CALLE_CONSENT_REFERENCE=
CALLE_LIVE_ACK=

# Reuse this exact key and request body when recovering from a lost create response.
CALLE_IDEMPOTENCY_KEY=

